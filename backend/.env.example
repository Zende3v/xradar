# Copy to .env and adjust for your VPS.
PORT=8080

# Admin API token — required to enable /api/admin/* and the xradar-accounts CLI.
# Use a long random string; the CLI's X_RADAR_ADMIN_TOKEN must match.
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Persisted stores (defaults shown). The dir must be writable by the service.
# REPORTS_FILE=./data/reports.json
# ACCOUNTS_FILE=./data/accounts.json

# Override only if needed:
# RADAR_DATASET_API_URL=https://www.data.gouv.fr/api/1/datasets/liste-des-radars-fixes-en-france/
# REFRESH_INTERVAL_MS=86400000
