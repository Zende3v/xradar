# Cloudflare Tunnel for XRadar: api.lrda-mercuriale.uk -> backend (8090) and
# confidentialite.zylo-app.fr -> privacy page (9020), with no port open for them.
# Config: /etc/cloudflared/xradar.yml (see deploy/cloudflared-xradar.yml); the tunnel's
# credentials stay in /root/.cloudflared/<tunnel id>.json (root only, never versioned).
[Unit]
Description=XRadar Cloudflare Tunnel
After=network-online.target xradar-backend.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel --config /etc/cloudflared/xradar.yml run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
