[Unit]
Description=EONA - politique de confidentialite (port 9020)
After=network.target

[Service]
User=eona
Group=eona
ExecStart=/usr/bin/python3 -m http.server 9020 --bind 127.0.0.1 --directory /opt/eona-backend/privacy
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
