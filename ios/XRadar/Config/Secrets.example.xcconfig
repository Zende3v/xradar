// Copy to Secrets.xcconfig (git-ignored) and fill in. Never commit real values.

// Same Stadia Maps key as the Android build (client.stadiamaps.com).
XR_STADIA_API_KEY = your_stadia_api_key

// Apple Developer team ID — needed to run on a real iPhone.
DEVELOPMENT_TEAM = ABCDE12345

// Uncomment to target another backend (host only, no scheme).
// XR_BACKEND_HOST = debian.taila9954f.ts.net
